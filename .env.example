# ── API ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://idb:idb@localhost:5432/beauty_passport
# jwt | dev   (dev запрещён при NODE_ENV=production)
AUTH_MODE=dev
# Для AUTH_MODE=jwt — одно из двух:
JWT_JWKS_URL=
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CUSTOMER_CLAIM=sub
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
SHOW_DRAFT_BADGE=true
SHOW_TRAIT_SUBTITLE=true
COUNT_SKIPPED_CATEGORY=true
RETENTION_DAYS=365
# Конструктор (X-Admin-Token), ≥16 символов. Пусто — админ-API выключен
ADMIN_TOKEN=
# Сервисный API для ENSI (X-Api-Key), ≥16 символов. Пусто — выключен
INTEGRATION_API_KEY=

# ── Worker / ENSI ──────────────────────────────────────────────
# mock | file | http
ENSI_SINK=file
ENSI_FILE_DIR=./.ensi-out
ENSI_BASE_URL=
ENSI_AUTH_HEADER=Authorization
ENSI_AUTH_VALUE=
ENSI_PROFILE_PATH=
ENSI_PROFILE_METHOD=PUT
ENSI_FETCH_PATH=
ENSI_TIMEOUT_MS=10000
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10

# ── Web ────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:3000
